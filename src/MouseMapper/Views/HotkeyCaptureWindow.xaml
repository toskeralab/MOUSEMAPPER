<Window x:Class="MouseMapper.Views.HotkeyCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Definir atalho"
        Width="540" Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        SnapsToDevicePixels="True">
    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="28,24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="Definir atalho global"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushText}" />
                    <TextBlock Text="Pressione a combinação desejada. ESC cancela."
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
                <Button Content="✕"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Style="{StaticResource GhostButtonStyle}"
                        Padding="8,2"
                        FontSize="13"
                        Click="Cancel_Click"
                        ToolTip="Cancelar" />
            </Grid>

            <!-- Preview das teclas -->
            <Border Grid.Row="1"
                    Margin="0,22,0,0"
                    Background="{StaticResource BrushSurfaceAlt}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,16"
                    VerticalAlignment="Stretch">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="PreviewText"
                               Text="Aguardando teclas…"
                               FontSize="30"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBlock x:Name="HintText"
                               Text="Segure os modificadores (Ctrl, Alt, Shift, Win) e pressione a tecla principal."
                               Margin="0,10,0,0"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextMuted}" />
                </StackPanel>
            </Border>

            <!-- Regras -->
            <TextBlock Grid.Row="2"
                       Margin="2,14,2,0"
                       TextWrapping="Wrap"
                       FontSize="11.5"
                       Foreground="{StaticResource BrushTextMuted}"
                       Text="Aceita combinações com pelo menos um modificador, ou teclas de função (F1–F12) sem modificador." />

            <!-- Ações -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
