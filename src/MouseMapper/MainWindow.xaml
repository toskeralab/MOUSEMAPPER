<Window x:Class="MouseMapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MOUSEMAPPER"
        Height="740" Width="1120"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushBackground}"
        Foreground="{StaticResource BrushText}"
        FontFamily="Segoe UI"
        Icon="Assets/mousemapper.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Cabeçalho ============================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushBorderSoft}"
                BorderThickness="0,0,0,1"
                Padding="26,18">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/mousemapper.ico" Width="40" Height="40" Margin="0,0,14,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MOUSEMAPPER"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource BrushText}" />
                        <TextBlock Text="Grave e reproduza macros de mouse com atalhos globais"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="NewAutomationButton"
                        Content="+  Mapear nova automação"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewAutomation_Click" />
            </Grid>
        </Border>

        <!-- ============================ Lista de macros =========================== -->
        <Grid Grid.Row="1" Margin="26,20,26,0">
            <Border Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <DataGrid x:Name="AutomationsGrid"
                              Margin="2,2,2,4"
                              CanUserSortColumns="False"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <!-- Nome + resumo -->
                            <DataGridTemplateColumn Header="NOME" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource BrushText}" />
                                            <TextBlock Text="{Binding EventSummary}"
                                                       FontSize="11.5"
                                                       Margin="0,3,0,0"
                                                       Foreground="{StaticResource BrushTextMuted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Atalho -->
                            <DataGridTemplateColumn Header="ATALHO" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BrushSurfaceAlt}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="9,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Hotkey.Display}"
                                                       FontFamily="Consolas"
                                                       FontSize="12.5"
                                                       Foreground="#CFE0FF" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Data de criação -->
                            <DataGridTemplateColumn Header="CRIADA EM" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="12.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource BrushTextMuted}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Ações -->
                            <DataGridTemplateColumn Header="AÇÕES" Width="248">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Reproduzir"
                                                    Style="{StaticResource TinyButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="PlayAutomation_Click"
                                                    ToolTip="Executar agora (ou pressione o atalho em qualquer app)" />
                                            <Button Content="Editar"
                                                    Style="{StaticResource TinyGhostButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Click="EditAutomation_Click" />
                                            <Button Content="Excluir"
                                                    Style="{StaticResource TinyDangerButtonStyle}"
                                                    Click="DeleteAutomation_Click" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estado vazio -->
                    <StackPanel x:Name="EmptyState"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border Width="68"
                                Height="68"
                                CornerRadius="18"
                                Background="{StaticResource BrushSurfaceAlt}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="🖱"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Nenhuma automação mapeada"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,18,0,6" />
                        <TextBlock Text="Crie sua primeira macro: escolha um nome, defina o atalho e grave os cliques."
                                   FontSize="12.5"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="420"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <Button Content="Mapear nova automação"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Click="NewAutomation_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================================ Rodapé ================================ -->
        <Grid Grid.Row="2" Margin="26,12,26,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot"
                         Width="8"
                         Height="8"
                         Fill="{StaticResource BrushSuccess}"
                         Margin="0,0,9,0" />
                <TextBlock x:Name="StatusText"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Text="Pronto."
                           Foreground="{StaticResource BrushTextMuted}" />
            </StackPanel>

            <TextBlock x:Name="DataPathText"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="11"
                       MaxWidth="480"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource BrushTextMuted}"
                       ToolTipService.InitialShowDelay="300" />
        </Grid>

        <!-- ============================== Editor inline ============================ -->
        <Grid x:Name="EditorOverlay"
              Grid.RowSpan="3"
              Background="#CC05070B"
              Visibility="Collapsed">
            <Border Width="600"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle"
                               Text="Nova automação"
                               FontSize="19"
                               FontWeight="Bold" />
                    <TextBlock x:Name="EditorSubtitle"
                               Text="Defina um nome e uma combinação de teclas para gravar sua macro."
                               FontSize="12"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextMuted}" />

                    <TextBlock Text="NOME DA AUTOMAÇÃO"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Margin="2,22,0,7"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <TextBox x:Name="NameBox"
                             MaxLength="64"
                             TextChanged="NameBox_TextChanged" />
                    <TextBlock x:Name="NameMessage"
                               FontSize="11.5"
                               Margin="2,6,0,0"
                               Visibility="Collapsed"
                               Foreground="{StaticResource BrushDanger}" />

                    <TextBlock Text="ATALHO GLOBAL"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Margin="2,18,0,7"
                               Foreground="{StaticResource BrushTextMuted}" />
                    <Border x:Name="HotkeyBox"
                            Background="{StaticResource BrushSurfaceAlt}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Cursor="Hand"
                            MouseLeftButtonUp="HotkeyBox_MouseLeftButtonUp">
                        <Grid>
                            <TextBlock x:Name="HotkeyPreview"
                                       Text="Clique para capturar o atalho…"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       Foreground="{StaticResource BrushTextMuted}" />
                            <TextBlock Text="⌨"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource BrushTextMuted}" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="HotkeyMessage"
                               FontSize="11.5"
                               Margin="2,6,0,0"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Border Background="#0F1929"
                            BorderBrush="#1E3350"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,16,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   FontSize="11.5"
                                   Foreground="#9DB6D8"
                                   Text="Ao clicar em Gravar, o MOUSEMAPPER minimiza para a bandeja e começa a capturar. Pressione o mesmo atalho para encerrar a gravação — os eventos são salvos automaticamente." />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancelar"
                                Style="{StaticResource GhostButtonStyle}"
                                Margin="0,0,10,0"
                                Click="CancelEditor_Click" />
                        <Button x:Name="RecordAgainButton"
                                Content="Regravar"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,10,0"
                                Visibility="Collapsed"
                                ToolTip="Descarta os eventos atuais e grava uma nova sequência com o mesmo atalho"
                                Click="RecordAgain_Click" />
                        <Button x:Name="RecordButton"
                                Content="Gravar automação"
                                Style="{StaticResource PrimaryButtonStyle}"
                                IsEnabled="False"
                                Click="RecordButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
